# 服务器基础配置
HOST=0.0.0.0
HTTP_PORT=3000
LOG_LEVEL=info

# 代理模式配置
STREAMING_MODE=real  # real (真实流) 或 fake (伪流)

# 账户切换策略
SWITCH_ON_FAILURE=true  # 失败时自动切换账户
SWITCH_ON_USES=10  # 每使用N次切换账户
MAX_RETRIES=3  # 最大重试次数
RETRY_DELAY=1000  # 重试延迟(毫秒)

# 超时设置
BROWSER_TIMEOUT=120000  # 浏览器启动超时(毫秒)
REQUEST_TIMEOUT=300000  # 请求超时(毫秒)

# 立即切换的状态码列表
IMMEDIATE_SWITCH_STATUS_CODES=429,503

# 浏览器配置
BROWSER_HEADLESS=true  # 无头模式
BROWSER_USER_DATA_DIR=/app/browser-data  # 用户数据目录

# 日志配置
LOG_ROTATION_SIZE=10485760  # 日志轮转大小(10MB)
LOG_ROTATION_COUNT=5  # 保留的日志文件数量

# 性能优化
MAX_BROWSER_INSTANCES=3  # 最大浏览器实例数
CONNECTION_POOL_SIZE=10  # 连接池大小

# 安全设置
RATE_LIMIT_ENABLED=true  # 启用速率限制
RATE_LIMIT_REQUESTS=100  # 每分钟最大请求数
ALLOWED_ORIGINS=*  # 允许的源

# 监控设置
METRICS_ENABLED=true  # 启用指标收集
METRICS_PORT=9090  # 指标端口