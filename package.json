{
  "name": "aistudio-to-api",
  "version": "2.0.0",
  "description": "Google AI Studio to API Proxy - Advanced AI API Gateway",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev": "nodemon main.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docker:build": "docker build -t aistudio-to-api .",
    "docker:run": "docker run -d -p 3000:3000 -v $(pwd)/configs:/app/configs -v $(pwd)/logs:/app/logs aistudio-to-api",
    "docker:compose": "docker-compose up -d",
    "logs": "docker logs -f aistudio-proxy",
    "stop": "docker-compose down",
    "restart": "docker-compose restart",
    "health": "curl -f http://localhost:3000/health || echo 'Service unhealthy'",
    "setup": "node scripts/setup.js"
  },
  "keywords": [
    "google-ai",
    "gemini",
    "openai",
    "claude",
    "api",
    "proxy",
    "ai",
    "machine-learning"
  ],
  "author": "miaoge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/miaoge/AIStudioToAPI.git"
  },
  "bugs": {
    "url": "https://github.com/miaoge2026/AIStudioToAPI/issues"
  },
  "homepage": "https://github.com/miaoge2026/AIStudioToAPI#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "puppeteer": "^21.5.2",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "semver": "^7.5.4",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "node-cache": "^5.1.2",
    "prom-client": "^15.0.0",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^6.0.3"
  }
}